{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "/public/portal-login.html"
    },
    {
      "src": "/gestores",
      "dest": "/public/dashboard-gestores.html"
    },
    {
      "src": "/inspecoes",
      "dest": "https://sueds-inspecoes.vercel.app/inspecoes"
    },
    {
      "src": "/inspecoes/(.*)",
      "dest": "https://sueds-inspecoes.vercel.app/inspecoes/$1"
    },
    {
      "src": "/plaza-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/cabralia-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/segundo-sol-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/premium-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/trancoso-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/casas-arraial-opinarios",
      "dest": "/public/enviar-opinarios-plaza.html"
    },
    {
      "src": "/operacional/plaza",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/operacional/cabralia",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/operacional/segundo-sol",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/operacional/premium",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/operacional/trancoso",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/operacional/casas-arraial",
      "dest": "/public/dashboard-operacional-plaza.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/",
      "dest": "/public/dashboard-tv.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
